# SMTP configuration used by the contact form (pages/api/contact.ts)
# Copy this file to .env.local and fill in real values.

# Mail server host, e.g. smtp.gmail.com
SMTP_HOST=smtp.gmail.com

# Mail server port, e.g. 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587

# Set to "true" only when using port 465 (implicit SSL)
SMTP_SECURE=false

# SMTP account credentials
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-password-or-app-password

# "From" address used when sending the enquiry email
SMTP_FROM_EMAIL=your-email@gmail.com

# Inbox that receives contact form submissions
EMAIL_RECIPIENT=azhagaaar@gmail.com
